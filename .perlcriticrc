# .perlcriticrc for a Perl project with Dist::Zilla
# Enable a subset of Perl::Critic policies for clean, modern Perl code

severity = 5
theme = core
verbose = 6

# Disable overly restrictive or opinionated policies
# Allow flexibility in code formatting
[-CodeLayout::RequireTidyCode]
# Dist::Zilla often handles POD
[-Documentation::RequirePodSections]
# Prototypes are sometimes useful
[-Subroutines::ProhibitSubroutinePrototypes]
# Allow common Perl variables like $_
[-Variables::ProhibitPunctuationVars]

# Enable policies for maintainability and clarity
# Use spaces for indentation
[CodeLayout::ProhibitHardTabs]
# Enforce consistent line endings
[CodeLayout::RequireConsistentNewlines]
# Require 'use strict'
[TestingAndDebugging::RequireUseStrict]
# Require 'use warnings'
[TestingAndDebugging::RequireUseWarnings]
# Catch unused variables
[Variables::ProhibitUnusedVariables]
# Avoid explicit 'return undef'
[Subroutines::ProhibitExplicitReturnUndef]
# Safer print/printf usage
[InputOutput::RequireBracedFileHandleWithPrint]
# Ensure module version is defined
[Modules::RequireVersionVar]
# Avoid postfix if/unless/while
[ControlStructures::ProhibitPostfixControls]
# Keep regexes manageable
[RegularExpressions::ProhibitComplexRegexes]
